# ============================================================
# Copie este arquivo para ".env.local" (uso local) e configure
# as MESMAS variáveis em Vercel > Project > Settings > Environment Variables
# ============================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-SECRETA

# Mercado Pago (Suas integrações > Credenciais de PRODUÇÃO)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx

# URL pública do site (após publicar na Vercel, ex: https://corridaspoa.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave simples para validar o formulário de cadastro (anti-spam extra, opcional)
FORM_HONEYPOT_FIELD=website_confirmacao
